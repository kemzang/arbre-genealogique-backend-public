generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int                    @id @default(autoincrement())
  email                  String                 @unique
  passwordHash           String                 @map("password_hash")
  displayName            String?                @map("display_name")
  profilePictureUrl      String?                @map("profile_picture_url")
  isSuperAdmin           Boolean                @default(false) @map("is_super_admin")
  createdAt              DateTime               @default(now()) @map("created_at")
  chatRoomParticipations ChatRoomParticipant[]
  createdChatRooms       ChatRoom[]             @relation("ChatRoomCreator")
  createdEvents          FamilyEvent[]          @relation("EventCreator")
  uploadedMedia          Media[]
  members                Member[]
  validationsGiven       MembershipValidation[] @relation("ValidationsByUser")
  messages               Message[]
  linkedPersons          Person[]               @relation("UserLinkedPersons")
  mergeRequests          FamilyMergeRequest[]
  passwordResetTokens    PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "password_reset_tokens_user_id_fkey")
  @@map("password_reset_tokens")
}

model Family {
  id           Int                   @id @default(autoincrement())
  familyName   String                @map("family_name")
  logoUrl      String?               @map("logo_url")
  createdAt    DateTime              @default(now()) @map("created_at")
  chatRooms    ChatRoom[]
  media        Media[]
  members      Member[]
  persons      Person[]
  sharedEvents FamilyEventOnFamily[]
  
  // Relations for family connections and mergers
  outgoingMergeRequests FamilyMergeRequest[] @relation("SourceFamily")
  incomingMergeRequests FamilyMergeRequest[] @relation("TargetFamily")
  connectionsA          FamilyConnection[]   @relation("FamilyA")
  connectionsB          FamilyConnection[]   @relation("FamilyB")

  @@map("families")
}

model Member {
  id              Int                    @id @default(autoincrement())
  userId          Int                    @map("user_id")
  familyId        Int                    @map("family_id")
  role            Role                   @default(VIEWER)
  status          MemberStatus           @default(PENDING)
  joinedAt        DateTime               @default(now()) @map("joined_at")
  applicationData String?                @map("application_data") @db.LongText
  family          Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  validations     MembershipValidation[] @relation("targetValidations")

  @@index([familyId], map: "members_family_id_fkey")
  @@index([userId], map: "members_user_id_fkey")
  @@map("members")
}

model MembershipValidation {
  id             Int      @id @default(autoincrement())
  targetMemberId Int      @map("target_member_id")
  validatorId    Int      @map("validator_id")
  voteType       VoteType @map("vote_type")
  createdAt      DateTime @default(now()) @map("created_at")
  targetMember   Member   @relation("targetValidations", fields: [targetMemberId], references: [id], onDelete: Cascade)
  validator      User     @relation("ValidationsByUser", fields: [validatorId], references: [id], onDelete: Cascade)

  @@unique([targetMemberId, validatorId])
  @@index([validatorId], map: "membership_validations_validator_id_fkey")
  @@map("membership_validations")
}

model Person {
  id                Int            @id @default(autoincrement())
  familyId          Int            @map("family_id")
  firstName         String?        @map("first_name")
  lastName          String?        @map("last_name")
  birthDate         DateTime?      @map("birth_date")
  deathDate         DateTime?      @map("death_date")
  gender            Gender?
  bio               String?
  profilePictureUrl String?        @map("profile_picture_url")
  linkedUserId      Int?           @map("linked_user_id")
  eventInvitations  EventGuest[]
  media             Media[]
  family            Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  linkedUser        User?          @relation("UserLinkedPersons", fields: [linkedUserId], references: [id])
  relationshipsA    Relationship[] @relation("relA")
  relationshipsB    Relationship[] @relation("relB")
  targetEvents      FamilyEvent[]  @relation("EventTargetBranch")
  
  // Relations pour les demandes de fusion
  sourceRequests    FamilyMergeRequest[] @relation("SourcePersonRequests")
  targetRequests    FamilyMergeRequest[] @relation("TargetPersonRequests")

  @@index([familyId], map: "persons_family_id_fkey")
  @@index([linkedUserId], map: "persons_linked_user_id_fkey")
  @@map("persons")
}

model Relationship {
  id           Int              @id @default(autoincrement())
  personAId    Int              @map("person_a_id")
  personBId    Int              @map("person_b_id")
  type         RelationshipType @map("type")
  isBiological Boolean          @default(true) @map("is_biological")
  
  // Nouveaux champs pour l'historique et le statut
  status       RelationshipStatus @default(ACTIVE) @map("status")
  startDate    DateTime?        @map("start_date")    // Date de début (mariage, naissance, etc.)
  endDate      DateTime?        @map("end_date")      // Date de fin (divorce, décès, etc.)
  endReason    String?          @map("end_reason")    // Raison de la fin (divorce, décès, etc.)
  notes        String?          @map("notes")         // Notes additionnelles
  
  personA      Person           @relation("relA", fields: [personAId], references: [id], onDelete: Cascade)
  personB      Person           @relation("relB", fields: [personBId], references: [id], onDelete: Cascade)

  @@index([personAId], map: "relationships_person_a_id_fkey")
  @@index([personBId], map: "relationships_person_b_id_fkey")
  @@map("relationships")
}

model FamilyMergeRequest {
  id               Int           @id @default(autoincrement())
  sourceFamilyId   Int           @map("source_family_id")
  targetFamilyId   Int           @map("target_family_id")
  requesterId      Int           @map("requester_id")
  status           RequestStatus @default(PENDING)
  createdAt        DateTime      @default(now()) @map("created_at")
  
  // Nouvelles colonnes pour spécifier la relation concrète
  sourcePersonId   Int           @map("source_person_id")  // Personne de la famille source
  targetPersonId   Int           @map("target_person_id")  // Personne de la famille cible
  relationshipType RelationshipType @map("relationship_type") // Type de relation (UNION, PARENTAL, etc.)
  justification    String?       @map("justification")     // Explication de la demande
  
  sourceFamily     Family        @relation("SourceFamily", fields: [sourceFamilyId], references: [id], onDelete: Cascade)
  targetFamily     Family        @relation("TargetFamily", fields: [targetFamilyId], references: [id], onDelete: Cascade)
  requester        User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  sourcePerson     Person        @relation("SourcePersonRequests", fields: [sourcePersonId], references: [id], onDelete: Cascade)
  targetPerson     Person        @relation("TargetPersonRequests", fields: [targetPersonId], references: [id], onDelete: Cascade)

  @@map("family_merge_requests")
}

model FamilyConnection {
  id        Int      @id @default(autoincrement())
  familyAId Int      @map("family_a_id")
  familyBId Int      @map("family_b_id")
  createdAt DateTime @default(now()) @map("created_at")

  familyA   Family   @relation("FamilyA", fields: [familyAId], references: [id], onDelete: Cascade)
  familyB   Family   @relation("FamilyB", fields: [familyBId], references: [id], onDelete: Cascade)

  @@unique([familyAId, familyBId])
  @@map("family_connections")
}

model ChatRoom {
  id           Int                   @id @default(autoincrement())
  familyId     Int                   @map("family_id")
  name         String?
  description  String?
  avatarUrl    String?               @map("avatar_url")
  channelType  ChannelType           @default(PUBLIC) @map("channel_type")
  createdAt    DateTime              @default(now()) @map("created_at")
  creatorId    Int?                  @map("creator_id")
  participants ChatRoomParticipant[]
  creator      User?                 @relation("ChatRoomCreator", fields: [creatorId], references: [id])
  family       Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([creatorId], map: "chat_rooms_creator_id_fkey")
  @@index([familyId], map: "chat_rooms_family_id_fkey")
  @@map("chat_rooms")
}

model ChatRoomParticipant {
  id         Int      @id @default(autoincrement())
  chatRoomId Int      @map("chat_room_id")
  userId     Int      @map("user_id")
  role       ChatRole @default(MEMBER)
  joinedAt   DateTime @default(now()) @map("joined_at")
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId])
  @@index([userId], map: "chat_room_participants_user_id_fkey")
  @@map("chat_room_participants")
}

model Message {
  id          Int      @id @default(autoincrement())
  chatRoomId  Int      @map("chat_room_id")
  senderId    Int      @map("sender_id")
  content     String?
  sentAt      DateTime @default(now()) @map("sent_at")
  attachments Media[]
  chatRoom    ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatRoomId], map: "messages_chat_room_id_fkey")
  @@index([senderId], map: "messages_sender_id_fkey")
  @@map("messages")
}

model FamilyEvent {
  id             Int             @id @default(autoincrement())
  title          String?
  eventDate      DateTime?       @map("event_date")
  location       String?         @map("location")
  creatorId      Int?            @map("creator_id")
  visibility     EventVisibility @default(PUBLIC)
  targetPersonId Int?            @map("target_person_id")
  
  creator        User?           @relation("EventCreator", fields: [creatorId], references: [id])
  targetPerson   Person?         @relation("EventTargetBranch", fields: [targetPersonId], references: [id])
  
  guests         EventGuest[]
  media          Media[]
  sharedFamilies FamilyEventOnFamily[]

  @@index([creatorId], map: "family_events_creator_id_fkey")
  @@index([targetPersonId], map: "family_events_target_person_id_fkey")
  @@map("family_events")
}

model FamilyEventOnFamily {
  eventId  Int    @map("event_id")
  familyId Int    @map("family_id")
  event    FamilyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  family   Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([eventId, familyId])
  @@map("family_event_families")
}

model EventGuest {
  id       Int         @id @default(autoincrement())
  eventId  Int         @map("event_id")
  personId Int         @map("person_id")
  event    FamilyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person   Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, personId])
  @@index([personId], map: "event_guests_person_id_fkey")
  @@map("event_guests")
}

model Media {
  id         Int          @id @default(autoincrement())
  familyId   Int          @map("family_id")
  uploaderId Int          @map("uploader_id")
  personId   Int?         @map("person_id")
  eventId    Int?         @map("event_id")
  messageId  Int?         @map("message_id")
  urlPath    String       @map("url_path")
  mediaType  MediaType    @map("media_type")
  event      FamilyEvent? @relation(fields: [eventId], references: [id])
  family     Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  message    Message?     @relation(fields: [messageId], references: [id])
  person     Person?      @relation(fields: [personId], references: [id])
  uploader   User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([eventId], map: "media_event_id_fkey")
  @@index([familyId], map: "media_family_id_fkey")
  @@index([messageId], map: "media_message_id_fkey")
  @@index([personId], map: "media_person_id_fkey")
  @@index([uploaderId], map: "media_uploader_id_fkey")
  @@map("media")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum MemberStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VoteType {
  APPROVE
  REJECT
}

enum Gender {
  M
  F
  O
}

enum RelationshipType {
  PARENTAL
  UNION
  SIBLING
}

enum MediaType {
  IMAGE
  VIDEO
  FILE
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  RESTRICTED
  BRANCH
}

enum ChannelType {
  PUBLIC
  PRIVATE
}

enum ChatRole {
  ADMIN
  MEMBER
}

enum RelationshipStatus {
  ACTIVE      // Relation active (marié, vivant, etc.)
  ENDED       // Relation terminée (divorcé, séparé, etc.)
  DECEASED    // Une des personnes est décédée
}
