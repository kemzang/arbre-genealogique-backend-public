generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                 @id @default(uuid())
  email                  String                 @unique
  passwordHash           String                 @map("password_hash")
  displayName            String?                @map("display_name")
  profilePictureUrl      String?                @map("profile_picture_url")
  isSuperAdmin           Boolean                @default(false) @map("is_super_admin")
  createdAt              DateTime               @default(now()) @map("created_at")
  updatedAt              DateTime               @updatedAt @map("updated_at")
  chatRoomParticipations ChatRoomParticipant[]
  createdChatRooms       ChatRoom[]             @relation("ChatRoomCreator")
  createdEvents          FamilyEvent[]          @relation("EventCreator")
  uploadedMedia          Media[]
  members                Member[]
  validationsGiven       MembershipValidation[] @relation("ValidationsByUser")
  messages               Message[]
  readMessages           Message[]              @relation("MessageReadReceipts")
  linkedPersons          Person[]               @relation("UserLinkedPersons")
  mergeRequests          FamilyMergeRequest[]
  passwordResetTokens    PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Family {
  id           String                @id @default(uuid())
  familyName   String                @map("family_name")
  logoUrl      String?               @map("logo_url")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  chatRooms    ChatRoom[]
  media        Media[]
  members      Member[]
  persons      Person[]
  sharedEvents FamilyEventOnFamily[]

  outgoingMergeRequests FamilyMergeRequest[] @relation("SourceFamily")
  incomingMergeRequests FamilyMergeRequest[] @relation("TargetFamily")
  connectionsA          FamilyConnection[]   @relation("FamilyA")
  connectionsB          FamilyConnection[]   @relation("FamilyB")

  @@map("families")
}

model Member {
  id              String                 @id @default(uuid())
  userId          String                 @map("user_id")
  familyId        String                 @map("family_id")
  role            Role                   @default(VIEWER)
  status          MemberStatus           @default(PENDING)
  joinedAt        DateTime               @default(now()) @map("joined_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  applicationData String?                @map("application_data") @db.Text
  family          Family                 @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  validations     MembershipValidation[] @relation("targetValidations")

  @@index([familyId])
  @@index([userId])
  @@map("members")
}

model MembershipValidation {
  id             String   @id @default(uuid())
  targetMemberId String   @map("target_member_id")
  validatorId    String   @map("validator_id")
  voteType       VoteType @map("vote_type")
  createdAt      DateTime @default(now()) @map("created_at")
  targetMember   Member   @relation("targetValidations", fields: [targetMemberId], references: [id], onDelete: Cascade)
  validator      User     @relation("ValidationsByUser", fields: [validatorId], references: [id], onDelete: Cascade)

  @@unique([targetMemberId, validatorId])
  @@index([validatorId])
  @@map("membership_validations")
}

model Person {
  id                String         @id @default(uuid())
  familyId          String         @map("family_id")
  firstName         String?        @map("first_name")
  lastName          String?        @map("last_name")
  birthDate         DateTime?      @map("birth_date")
  deathDate         DateTime?      @map("death_date")
  gender            Gender?
  bio               String?
  profilePictureUrl String?        @map("profile_picture_url")
  linkedUserId      String?        @map("linked_user_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  deletedAt         DateTime?      @map("deleted_at")
  eventInvitations  EventGuest[]
  media             Media[]
  family            Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  linkedUser        User?          @relation("UserLinkedPersons", fields: [linkedUserId], references: [id])
  relationshipsA    Relationship[] @relation("relA")
  relationshipsB    Relationship[] @relation("relB")
  targetEvents      FamilyEvent[]  @relation("EventTargetBranch")
  sourceRequests    FamilyMergeRequest[] @relation("SourcePersonRequests")
  targetRequests    FamilyMergeRequest[] @relation("TargetPersonRequests")

  @@index([familyId])
  @@index([linkedUserId])
  @@map("persons")
}

model Relationship {
  id           String           @id @default(uuid())
  personAId    String           @map("person_a_id")
  personBId    String           @map("person_b_id")
  type         RelationshipType @map("type")
  isBiological Boolean          @default(true) @map("is_biological")
  status       RelationshipStatus @default(ACTIVE) @map("status")
  startDate    DateTime?        @map("start_date")
  endDate      DateTime?        @map("end_date")
  endReason    String?          @map("end_reason")
  notes        String?          @map("notes")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  deletedAt    DateTime?        @map("deleted_at")
  
  personA      Person           @relation("relA", fields: [personAId], references: [id], onDelete: Cascade)
  personB      Person           @relation("relB", fields: [personBId], references: [id], onDelete: Cascade)

  @@index([personAId])
  @@index([personBId])
  @@map("relationships")
}

model FamilyMergeRequest {
  id               String        @id @default(uuid())
  sourceFamilyId   String        @map("source_family_id")
  targetFamilyId   String        @map("target_family_id")
  requesterId      String        @map("requester_id")
  status           RequestStatus @default(PENDING)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  sourcePersonId   String        @map("source_person_id")
  targetPersonId   String        @map("target_person_id")
  relationshipType RelationshipType @map("relationship_type")
  justification    String?       @map("justification")
  
  sourceFamily     Family        @relation("SourceFamily", fields: [sourceFamilyId], references: [id], onDelete: Cascade)
  targetFamily     Family        @relation("TargetFamily", fields: [targetFamilyId], references: [id], onDelete: Cascade)
  requester        User          @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  sourcePerson     Person        @relation("SourcePersonRequests", fields: [sourcePersonId], references: [id], onDelete: Cascade)
  targetPerson     Person        @relation("TargetPersonRequests", fields: [targetPersonId], references: [id], onDelete: Cascade)

  @@map("family_merge_requests")
}

model FamilyConnection {
  id        String   @id @default(uuid())
  familyAId String   @map("family_a_id")
  familyBId String   @map("family_b_id")
  createdAt DateTime @default(now()) @map("created_at")

  familyA   Family   @relation("FamilyA", fields: [familyAId], references: [id], onDelete: Cascade)
  familyB   Family   @relation("FamilyB", fields: [familyBId], references: [id], onDelete: Cascade)

  @@unique([familyAId, familyBId])
  @@map("family_connections")
}

model ChatRoom {
  id           String                @id @default(uuid())
  familyId     String                @map("family_id")
  name         String?
  description  String?
  avatarUrl    String?               @map("avatar_url")
  channelType  ChannelType           @default(PUBLIC) @map("channel_type")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")
  deletedAt    DateTime?             @map("deleted_at")
  creatorId    String?               @map("creator_id")
  participants ChatRoomParticipant[]
  creator      User?                 @relation("ChatRoomCreator", fields: [creatorId], references: [id])
  family       Family                @relation(fields: [familyId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([creatorId])
  @@index([familyId])
  @@map("chat_rooms")
}

model ChatRoomParticipant {
  id         String    @id @default(uuid())
  chatRoomId String    @map("chat_room_id")
  userId     String    @map("user_id")
  role       ChatRole  @default(MEMBER)
  joinedAt   DateTime  @default(now()) @map("joined_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  leftAt     DateTime? @map("left_at")
  chatRoom   ChatRoom  @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatRoomId, userId])
  @@index([userId])
  @@map("chat_room_participants")
}

model Message {
  id          String    @id @default(uuid())
  chatRoomId  String    @map("chat_room_id")
  senderId    String    @map("sender_id")
  content     String?
  sentAt      DateTime  @default(now()) @map("sent_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  attachments Media[]
  chatRoom    ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  readBy      User[]   @relation("MessageReadReceipts")

  @@index([chatRoomId])
  @@index([senderId])
  @@map("messages")
}

model FamilyEvent {
  id             String          @id @default(uuid())
  title          String?
  eventDate      DateTime?       @map("event_date")
  location       String?         @map("location")
  creatorId      String?         @map("creator_id")
  visibility     EventVisibility @default(PUBLIC)
  targetPersonId String?         @map("target_person_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  deletedAt      DateTime?       @map("deleted_at")
  
  creator        User?           @relation("EventCreator", fields: [creatorId], references: [id])
  targetPerson   Person?         @relation("EventTargetBranch", fields: [targetPersonId], references: [id])
  
  guests         EventGuest[]
  media          Media[]
  sharedFamilies FamilyEventOnFamily[]

  @@index([creatorId])
  @@index([targetPersonId])
  @@map("family_events")
}

model FamilyEventOnFamily {
  eventId  String @map("event_id")
  familyId String @map("family_id")
  event    FamilyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  family   Family      @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@id([eventId, familyId])
  @@map("family_event_families")
}

model EventGuest {
  id       String      @id @default(uuid())
  eventId  String      @map("event_id")
  personId String      @map("person_id")
  event    FamilyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  person   Person      @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([eventId, personId])
  @@index([personId])
  @@map("event_guests")
}

model Media {
  id         String       @id @default(uuid())
  familyId   String       @map("family_id")
  uploaderId String       @map("uploader_id")
  personId   String?      @map("person_id")
  eventId    String?      @map("event_id")
  messageId  String?      @map("message_id")
  urlPath    String       @map("url_path")
  mediaType  MediaType    @map("media_type")
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  event      FamilyEvent? @relation(fields: [eventId], references: [id])
  family     Family       @relation(fields: [familyId], references: [id], onDelete: Cascade)
  message    Message?     @relation(fields: [messageId], references: [id])
  person     Person?      @relation(fields: [personId], references: [id])
  uploader   User         @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([familyId])
  @@index([messageId])
  @@index([personId])
  @@index([uploaderId])
  @@map("media")
}

enum Role {
  ADMIN
  EDITOR
  VIEWER
}

enum MemberStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VoteType {
  APPROVE
  REJECT
}

enum Gender {
  M
  F
  O
}

enum RelationshipType {
  PARENTAL
  UNION
  SIBLING
}

enum MediaType {
  IMAGE
  VIDEO
  FILE
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  RESTRICTED
  BRANCH
}

enum ChannelType {
  PUBLIC
  PRIVATE
}

enum ChatRole {
  ADMIN
  MEMBER
}

enum RelationshipStatus {
  ACTIVE
  ENDED
  DECEASED
}
